# Optimized .dockerignore for faster builds and smaller contexts

# Version control
.git
.gitignore
.gitattributes

# IDEs and editors
.idea
.vscode
*.swp
*.swo
*~

# Dependencies (will be installed in container)
node_modules
**/node_modules
frontend/node_modules
backend/node_modules

# Build outputs and caches
dist
**/dist
build
**/build
.turbo
**/.turbo
.next
**/.next
.cache
**/.cache
.vite
**/.vite
coverage
**/coverage

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
backend/logs

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Local data directories
dumps
*.sql
*.dump
*.backup
postgres
uploads
data/uploads
backend/uploads

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
/tmp
/temp

# Development and testing
.nyc_output
coverage/
*.tsbuildinfo

# Docker
.dockerignore
Dockerfile*
!backend/Dockerfile*
!frontend/Dockerfile*
docker-compose*

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
.circleci/

# Documentation
# The marketing app only imports the Google Meet guides during Docker builds.
docs/*